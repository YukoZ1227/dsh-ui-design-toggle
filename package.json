{
  "name": "dsh-ui-design-toggle",
  "version": "0.2.1",
  "description": "DSH plugin: a sidebar switch that enables or disables the ui-ux-pro-max UI/UX design skill at runtime.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./gate": {
      "default": "./lib/gate.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "files": [
    "lib/index.js",
    "lib/gate.js",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-skill": ">=0.2.1-rc.1",
    "@deepseek-ai/schemastery": "~3.18.5"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "dsh-plugin-market",
    "plugin",
    "skill",
    "skill-toggle",
    "sidebar",
    "ui",
    "ui-ux-pro-max",
    "design"
  ],
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.1-rc.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YukoZ1227/dsh-ui-design-toggle.git"
  },
  "homepage": "https://github.com/YukoZ1227/dsh-ui-design-toggle#readme",
  "bugs": {
    "url": "https://github.com/YukoZ1227/dsh-ui-design-toggle/issues"
  },
  "author": "YukoZ1227",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node test/gate.test.mjs",
    "prepack": "node --check lib/index.js && node --check lib/gate.js && node --check lib/client.js",
    "release": "npm version patch && git push --follow-tags"
  },
  "license": "MIT"
}
